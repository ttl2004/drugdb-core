# Cấu hình ETL. Sao chép thành .env rồi điền giá trị.
# Đường dẫn tương đối được tính từ thư mục Test-New-ETL.

# ---------- ETL 1: XML SPL (FDA) -> CSV
# Thư mục dữ liệu gốc: 5 thư mục XML (animal, homeopathic, otc, other, prescription) + dash4dm_work (DSV)
SPL_DATA_DIR=E:\Project\DoAnTotNghiep\Data\XuLyData\datas
ETL1_OUTPUT_DIR=output\etl1
# 1 = ghi cột text_xml / text_plain của label_section, 0 = bỏ (file nhẹ hơn)
ETL1_INCLUDE_TEXT_XML=1
ETL1_INCLUDE_TEXT_PLAIN=1
# 1 = label_section.jsonl thụt lề cho dễ đọc (file to hơn)
ETL1_JSON_PRETTY=0

# ---------- ETL 2: CSV của ETL 1 -> 21 cột CSDL Dược quốc gia
# Thư mục CSV của ETL 1 (cần cả label_section.jsonl). Tạm trỏ vào processed/ thật;
# khi chạy nối tiếp ETL 1 thì đổi thành output\etl1
ETL2_INPUT_DIR=E:\Project\DoAnTotNghiep\Data\XuLyData\processed
ETL2_OUTPUT_DIR=output\etl2
# Từ điển Anh -> Việt (duong_dung, bao_bi, don_vi_dem, don_vi); bước translate ghi thêm vào đây
ETL2_DICTIONARY_DIR=dictionaries

# DeepSeek, chỉ dùng cho bước translate (dịch từ còn thiếu trong từ điển)
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
